# --- Obligatorio ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Voz (opcional: sin estas claves puedes usar el modo texto) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Contraseñas de correo (referenciadas desde config/jarvis.yaml con ${VAR}) ---
EMAIL_VENTAS_PASSWORD=
EMAIL_SOPORTE_PASSWORD=

# --- Tokens para MCP (ERP / CRM), referenciados desde config/jarvis.yaml ---
ERP_MCP_TOKEN=
CRM_MCP_TOKEN=

# --- Notificaciones por Telegram (opcional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
