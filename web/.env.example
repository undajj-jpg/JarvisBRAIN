# Variables de entorno para la versión web (en Vercel: Settings → Environment Variables)

# Obligatorio — el cerebro
ANTHROPIC_API_KEY=sk-ant-...

# Voz (sin esto la app funciona solo con texto)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Cuentas de correo de la empresa (JSON en una sola línea)
EMAIL_ACCOUNTS=[{"name":"ventas","imapHost":"imap.gmail.com","smtpHost":"smtp.gmail.com","smtpPort":587,"user":"ventas@miempresa.com","password":"xxxx"},{"name":"soporte","imapHost":"imap.gmail.com","smtpHost":"smtp.gmail.com","smtpPort":587,"user":"soporte@miempresa.com","password":"xxxx"}]

# Servidores MCP: ERP, CRM... (JSON en una sola línea)
MCP_SERVERS=[{"name":"erp","url":"https://erp.miempresa.com/mcp","headers":{"Authorization":"Bearer xxxx"},"blockedTools":["delete_*"],"confirmTools":["create_*","update_*","post_*"]},{"name":"crm","url":"https://crm.miempresa.com/mcp","headers":{"Authorization":"Bearer xxxx"},"confirmTools":["create_*","update_*","delete_*"]}]

# Ajustes opcionales del agente
# JARVIS_MODEL=claude-opus-4-8
# JARVIS_EFFORT=low
# JARVIS_MAX_TOKENS=16000
# JARVIS_LANGUAGE=es
